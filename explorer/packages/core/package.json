    "./views/attention": "./views/attention/index.ts",
    "./views/changelog": "./views/changelog/index.ts",
    "./views/coverage": "./views/coverage/index.ts",
    "./views/health": "./views/health/index.ts",
    "./views/relations": "./views/relations/index.ts",
    "./views/rulebooks": "./views/rulebooks/index.ts",
    "./views/rule": "./views/rule/index.ts",
    "./views/standing": "./views/standing/index.ts",
    "./views/terms": "./views/terms/index.ts",
    "./views/tools": "./views/tools/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --composite false --incremental false --listFiles -p tsconfig.json",
