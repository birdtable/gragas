  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.2",
    "@types/react-dom": "19.3.0",
    "@types/trusted-types": "2.0.7",
    "axe-core": "4.14.0",
    "msw": "3.0.4",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
