{
  "name": "@gragas/standalone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The explorer's standalone package: the shell around the views (router, chrome, data wiring).",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "routes": "tsr generate",
    "typecheck": "tsc --noEmit --composite false --incremental false --listFiles -p tsconfig.json",
    "build": "vite build",
    "test": "vitest run"
  },
  "dependencies": {
    "@gragas/contract": "workspace:*",
    "@gragas/core": "workspace:*",
    "@gragas/tokens": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.168.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "html-validate": "11.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
