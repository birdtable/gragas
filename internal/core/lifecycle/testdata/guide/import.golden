What is written where
rulebook/language/go/rules/errors.yaml: adds 12 rule(s)
rulebook/sources.yaml: adds source handler-guide
rulebook/decisions.yaml: adds decision imported-handler-guide-v1-2-0
rulebook/history.jsonl: appends 12 entries (import)
--- rule:go.style.2
id: go.style.2
statement: "Handler guide"
strength: should
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#handler-guide"
    backs: rule
--- rule:go.style.3
id: go.style.3
statement: "Handlers MUST log once per request."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#logging"
    backs: rule
--- rule:go.style.4
id: go.style.4
statement: "Handlers MUST NOT log secrets."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#logging"
    backs: rule
--- rule:go.style.5
id: go.style.5
statement: "Handlers SHOULD log at the edge."
strength: should
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#logging"
    backs: rule
--- rule:go.style.6
id: go.style.6
statement: "An error MUST be wrapped with context."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#errors"
    backs: rule
--- rule:go.style.7
id: go.style.7
statement: "An error MUST be handled once."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#errors"
    backs: rule
--- rule:go.style.8
id: go.style.8
statement: "A retry MUST be bounded."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#retries"
    backs: rule
--- rule:go.style.9
id: go.style.9
statement: "A retry MAY use jitter."
strength: may
status: active
origin: imported
owner: team-a
review_by: "2027-02-06"
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#retries"
    backs: rule
bindings:
  - tool: golangci-lint
    target: go-code
    key: jitter
    options: {"max":3}
    severity: warning
    rung: 1
    run_point: push
--- rule:go.style.10
id: go.style.10
statement: "Every call MUST carry a deadline."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#timeouts"
    backs: rule
--- rule:go.style.11
id: go.style.11
statement: "A deadline MUST come from the caller and SHOULD be short."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#timeouts"
    backs: rule
--- rule:go.style.12
id: go.style.12
statement: "Exported names MUST NOT stutter."
strength: must
status: active
origin: imported
owner: team-a
review_by: "2027-02-06"
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#naming"
    backs: rule
bindings:
  - tool: golangci-lint
    target: go-code
    key: stutter
    severity: error
    rung: 1
    run_point: push
--- rule:go.style.13
id: go.style.13
statement: "Test names MUST say the case."
strength: must
status: proposed
origin: imported
reasoning:
  decision: imported-handler-guide-v1-2-0
sources:
  - ref: handler-guide
    where: "#naming"
    backs: rule
