    }
  ],
  "Decisions": [
    {
      "slug": "wrap-errors",
      "title": "Wrap every error",
      "text": "Wrapping keeps the cause and adds the step.",
      "rejected": [
        "return errors bare"
      ],
      "cites": {
        "sources": [
          "effective-go"
        ],
