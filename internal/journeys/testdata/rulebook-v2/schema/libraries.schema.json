{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rulebook/lang/go/libraries.yaml: the register of libraries and tools a Go program calls instead of writing the code itself (supply.intake.6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["part", "libraries", "dropped"],
  "properties": {
    "part": {"const": "go"},
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "job", "use", "scope", "ban", "gap", "source", "state"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "job": {"type": "string", "minLength": 1},
          "use": {
            "type": "object",
            "additionalProperties": false,
            "required": ["module", "version", "package"],
            "properties": {
              "module": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"},
              "version": {"type": "string", "pattern": "^(v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|floor|toolchain|none)$"},
              "released": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "age": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "the day a release younger than the age window passes it"},
              "package": {"type": "string", "minLength": 1},
              "licence": {"type": "string", "minLength": 1, "description": "the SPDX name of the module's licence"}
            }
          },
          "scope": {"type": "string", "minLength": 1},
          "replaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "why"],
              "properties": {"name": {"type": "string", "minLength": 1}, "why": {"type": "string", "minLength": 1}}
            }
          },
          "by_hand": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "ban": {
            "type": "object",
            "additionalProperties": false,
            "dependentRequired": {"deny": ["linter"], "forbid": ["linter"]},
            "properties": {
              "deny": {"type": "array", "items": {"type": "string"}},
              "forbid": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pattern"],
                  "properties": {"pattern": {"type": "string", "minLength": 1}, "pkg": {"type": "string"}}
                }
              },
              "planned": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "note": {"type": "string", "minLength": 1},
              "linter": {
                "description": "the linter of the Go preset that holds the ban: one name, or a list for a row that bans imports and calls",
                "oneOf": [
                  {"enum": ["depguard", "forbidigo", "gomodguard_v2", "gomoddirectives"]},
                  {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["depguard", "forbidigo", "gomodguard_v2", "gomoddirectives"]}}
                ]
              }
            }
          },
          "gap": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "^https://"},
          "state": {"enum": ["chosen", "needs-spike", "conditional"]},
          "proof": {"type": "string", "minLength": 1},
          "open": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "if": {"properties": {"state": {"const": "conditional"}}},
        "then": {"required": ["proof"]}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "tools_yaml", "replaces", "source"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "tools_yaml": {"type": "string", "minLength": 1},
          "replaces": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "by"],
        "properties": {"name": {"type": "string", "minLength": 1}, "by": {"type": "string", "minLength": 1}}
      }
    }
  }
}
