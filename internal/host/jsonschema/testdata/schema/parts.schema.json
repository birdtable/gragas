{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parts.schema.json",
  "title": "The parts and layers of the rulebook: rulebook/parts.yaml (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers", "waivers", "parts"],
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z]+$", "description": "the layer folder under rulebook/"},
          "name": {"type": "string", "minLength": 2, "description": "the layer's name in the part READMEs"}
        }
      }
    },
    "waivers": {"$ref": "#/$defs/waivers", "description": "the default waiver for each strength; a part or a rule may set its own"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["short", "split", "layer", "name", "description", "builds_on", "bindings", "owner"],
        "properties": {
          "short": {"$ref": "common.schema.json#/$defs/short", "description": "the part's folder and the first segment of its rule ids"},
          "split": {"type": "string", "pattern": "^[a-z]+-[a-z]+$", "description": "the key the source split used for this part"},
          "layer": {"type": "string", "pattern": "^[a-z]+$", "description": "a key in layers"},
          "name": {"type": "string", "minLength": 2},
          "description": {"type": "string", "minLength": 10, "description": "what the part holds, one sentence"},
          "builds_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/short"}, "description": "parts this part builds on, besides the base"},
          "bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/binding"}, "description": "the bindings its checks may use"},
          "facets": {"$ref": "common.schema.json#/$defs/facets", "description": "the facets this part names: a project declares them, and a when or unless may test them"},
          "owner": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "who answers for the part's rules and grants its waivers (gates.registry.4)"},
          "when": {"$ref": "common.schema.json#/$defs/when", "description": "which products take the part; absent means every product"},
          "waivers": {"$ref": "#/$defs/waivers", "description": "this part's own default per strength, over the top-level one"}
        }
      }
    }
  },
  "$defs": {
    "waivers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "Hard": {"$ref": "common.schema.json#/$defs/waiver"},
        "Answered": {"$ref": "common.schema.json#/$defs/waiver"},
        "Session": {"$ref": "common.schema.json#/$defs/waiver"},
        "Lens": {"$ref": "common.schema.json#/$defs/waiver"},
        "Record": {"$ref": "common.schema.json#/$defs/waiver"},
        "Review": {"$ref": "common.schema.json#/$defs/waiver"}
      }
    }
  }
}
