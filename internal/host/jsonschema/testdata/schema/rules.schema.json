{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "One concern file of one part: rulebook/<layer>/<part>/rules/<concern>.yaml (schema v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "part",
    "concern",
    "title",
    "summary",
    "rules"
  ],
  "properties": {
    "part": {
      "$ref": "common.schema.json#/$defs/short",
      "description": "the part's short name, equal to its folder"
    },
    "concern": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "equal to the file name"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "what this concern is about, in a few sentences"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "position of this concern in the part's README"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "$ref": "#/$defs/ruleBody",
      "properties": {
        "part": false,
        "concern": false,
        "standing": false
      },
      "description": "an authored rule: gragas adds part, concern and standing in rules.json"
    },
    "ruleBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "since",
        "rule",
        "why",
        "kind",
        "strength",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "slug": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "since": {
          "$ref": "common.schema.json#/$defs/semver",
          "description": "the rulebook version the rule first shipped in (decision 55: one version)"
        },
        "rule": {
          "type": "string",
          "minLength": 10,
          "description": "the rule, generic, no organisation or product names"
        },
        "detail": {
          "type": "string",
          "description": "the full rule text when one sentence is not enough: thresholds, lists, edge cases"
        },
        "level": {
          "enum": [
            "word",
            "function",
            "type",
            "file",
            "package",
            "program",
            "deploy",
            "release",
            "process"
          ],
          "description": "display only"
        },
        "why": {
          "type": "string",
          "minLength": 3,
          "not": {
            "pattern": "^Evidence [A-D]"
          },
          "description": "the failure the rule prevents; evidence lives in sources"
        },
        "kind": {
          "enum": [
            "rule",
            "instruction",
            "measure"
          ]
        },
        "strength": {
          "$ref": "common.schema.json#/$defs/strength"
        },
        "status": {
          "enum": [
            "proposed",
            "active",
            "later",
            "retired"
          ],
          "description": "proposed: no source yet, or awaiting a ruling (decision 47)"
        },
        "replaced_by": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "when": {
          "$ref": "common.schema.json#/$defs/when"
        },
        "unless": {
          "$ref": "common.schema.json#/$defs/unless"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/citation"
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bad",
            "good"
          ],
          "properties": {
            "bad": {
              "$ref": "#/$defs/example"
            },
            "good": {
              "$ref": "#/$defs/example"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "review_question": {
          "type": "string",
          "minLength": 10
        },
        "promoted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on",
            "trial"
          ],
          "properties": {
            "on": {
              "$ref": "common.schema.json#/$defs/date"
            },
            "trial": {
              "$ref": "#/$defs/text",
              "description": "the trial or ruling that promoted it (decision 44)"
            }
          }
        },
        "limit": {
          "type": "number",
          "description": "a measure's line, when it has one"
        },
        "waiver": {
          "$ref": "common.schema.json#/$defs/waiver",
          "description": "overrides the default for the strength in parts.yaml"
        },
        "relates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "how"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "how": {
                "enum": [
                  "refines",
                  "narrows",
                  "conflicts",
                  "depends",
                  "see"
                ]
              },
              "wins": {
                "enum": [
                  "this",
                  "other"
                ],
                "description": "which rule holds where the two conflict"
              }
            },
            "if": {
              "properties": {
                "how": {
                  "const": "conflicts"
                }
              }
            },
            "then": {
              "required": [
                "wins"
              ]
            }
          }
        },
        "open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "doubts and work left"
        },
        "note": {
          "type": "string"
        },
        "part": {
          "$ref": "common.schema.json#/$defs/short",
          "description": "rules.json only: the part the rule is filed under"
        },
        "concern": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "rules.json only: the concern file the rule is filed in"
        },
        "standing": {
          "enum": [
            "enforced",
            "planned",
            "advisory",
            "later",
            "retired"
          ],
          "description": "rules.json only: derived by gragas, never written (decision 48)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "then": {
            "required": [
              "sources"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "later"
              }
            }
          },
          "then": {
            "required": [
              "when"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "retired"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "replaced_by"
                ]
              },
              {
                "required": [
                  "note"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strength": {
                "const": "Review"
              }
            }
          },
          "then": {
            "required": [
              "review_question"
            ]
          }
        }
      ],
      "description": "a rule's fields and the conditions between them; part, concern and standing appear only in rules.json, and rule forbids them"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "code"
      ],
      "properties": {
        "lang": {
          "type": "string",
          "pattern": "^[a-z0-9+-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "class",
        "tier"
      ],
      "properties": {
        "binding": {
          "$ref": "common.schema.json#/$defs/binding",
          "description": "one of the part's bindings in parts.yaml"
        },
        "class": {
          "enum": [
            "preset-rule",
            "preset-config",
            "pattern",
            "analyzer",
            "policy",
            "fact",
            "test-kit",
            "hook"
          ]
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "a key in a tools.yaml; R-12 requires it, and the baseline counts each check without one that resolves"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "the rule or linter name in the tool's preset; R-12 requires it, and the baseline counts each check without one that resolves"
        },
        "test": {
          "type": "string",
          "minLength": 1,
          "description": "the native test in the preset; R-12 requires it for pattern, analyzer, policy and fact checks, and the baseline counts each without one"
        },
        "tier": {
          "enum": [
            "G",
            "0",
            "1",
            "2",
            "3",
            "4",
            "R"
          ],
          "description": "G write time, 0 edit hook, 1 commit, 2 push, 3 land, 4 the full run, R release"
        },
        "fix": {
          "enum": [
            "auto",
            "suggest",
            "never"
          ],
          "description": "R-12 requires it; the baseline counts each check without one"
        },
        "note": {
          "type": "string",
          "description": "the v1 check text (enforced_by) and anything the fields above cannot say"
        }
      }
    }
  }
}
