{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure.schema.json",
  "title": "structure.yaml: layers, parts, concerns and kinds (format v3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "layers", "kinds"],
  "properties": {
    "format": {"$ref": "common.schema.json#/$defs/format"},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "parts"],
        "properties": {
          "slug": {"$ref": "common.schema.json#/$defs/slug"},
          "name": {"$ref": "common.schema.json#/$defs/text"},
          "aliases": {"$ref": "common.schema.json#/$defs/slugs", "description": "slugs the layer had before it was renamed"},
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "name", "concerns"],
              "properties": {
                "slug": {"$ref": "common.schema.json#/$defs/part"},
                "name": {"$ref": "common.schema.json#/$defs/text"},
                "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/part"}},
                "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/text"}},
                "concerns": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slug", "name"],
                    "properties": {
                      "slug": {"$ref": "common.schema.json#/$defs/slug"},
                      "name": {"$ref": "common.schema.json#/$defs/text"},
                      "aliases": {"$ref": "common.schema.json#/$defs/slugs"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "the order of each list is the order of the layers, parts and concerns"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name"],
        "properties": {
          "slug": {"$ref": "common.schema.json#/$defs/slug"},
          "name": {"$ref": "common.schema.json#/$defs/text"},
          "description": {"$ref": "common.schema.json#/$defs/text"}
        }
      }
    }
  }
}
