{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity-translation.schema.json",
  "title": "Translation of one field of one entity (entity, spec 16.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "field",
    "language",
    "text",
    "authoritative_hash",
    "stale"
  ],
  "properties": {
    "entity": {
      "$ref": "common.schema.json#/$defs/text",
      "x-introduced": "1.0"
    },
    "field": {
      "$ref": "common.schema.json#/$defs/slug",
      "x-introduced": "1.0"
    },
    "language": {
      "$ref": "common.schema.json#/$defs/language",
      "x-introduced": "1.0"
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text",
      "x-introduced": "1.0"
    },
    "authoritative_hash": {
      "$ref": "common.schema.json#/$defs/digest",
      "x-introduced": "1.0"
    },
    "stale": {
      "type": "boolean",
      "x-introduced": "1.0"
    }
  }
}
