{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity-rulebook.schema.json",
  "title": "Rulebook: the identity a document carries (entity, spec 16.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "kind",
    "licences",
    "language",
    "owners",
    "governance",
    "format"
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/slug",
      "x-introduced": "1.0"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver",
      "x-introduced": "1.0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "base",
        "overlay",
        "companion",
        "fork",
        "archived"
      ],
      "x-introduced": "1.0"
    },
    "licences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "$ref": "common.schema.json#/$defs/text",
          "x-introduced": "1.0"
        },
        "checker_code": {
          "$ref": "common.schema.json#/$defs/textOrEmpty",
          "x-introduced": "1.0",
          "default": ""
        },
        "presets": {
          "$ref": "common.schema.json#/$defs/textOrEmpty",
          "x-introduced": "1.0",
          "default": ""
        }
      },
      "x-introduced": "1.0"
    },
    "language": {
      "$ref": "common.schema.json#/$defs/language",
      "x-introduced": "1.0"
    },
    "docs_url": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/url"
        },
        {
          "type": "null"
        }
      ],
      "x-introduced": "1.0",
      "default": null
    },
    "explorer_url": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/url"
        },
        {
          "type": "null"
        }
      ],
      "x-introduced": "1.0",
      "default": null
    },
    "extends": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rulebook",
            "version"
          ],
          "properties": {
            "rulebook": {
              "$ref": "common.schema.json#/$defs/text",
              "x-introduced": "1.0"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/semver",
              "x-introduced": "1.0"
            },
            "content_hash": {
              "$ref": "common.schema.json#/$defs/digestOrEmpty",
              "x-introduced": "1.0",
              "x-decides": "the content hash the parent's release must have, so whether the fetched parent is accepted",
              "default": ""
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-introduced": "1.0",
      "default": null
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rulebook",
          "version",
          "parts"
        ],
        "properties": {
          "rulebook": {
            "$ref": "common.schema.json#/$defs/text",
            "x-introduced": "1.0"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/semver",
            "x-introduced": "1.0"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/slug"
            },
            "x-introduced": "1.0"
          },
          "content_hash": {
            "$ref": "common.schema.json#/$defs/digestOrEmpty",
            "x-introduced": "1.0",
            "x-decides": "the content hash the import's release must have, so whether the fetched import is accepted",
            "default": ""
          }
        }
      },
      "x-introduced": "1.0",
      "default": []
    },
    "owners": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "x-introduced": "1.0"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution",
        "decision_required",
        "trial_releases",
        "review_days"
      ],
      "properties": {
        "contribution": {
          "type": "string",
          "enum": [
            "open",
            "proposals",
            "closed"
          ],
          "x-introduced": "1.0"
        },
        "decision_required": {
          "type": "boolean",
          "x-introduced": "1.0"
        },
        "trial_releases": {
          "type": "integer",
          "minimum": 0,
          "x-introduced": "1.0"
        },
        "review_days": {
          "type": "integer",
          "minimum": 1,
          "x-introduced": "1.0"
        }
      },
      "x-introduced": "1.0"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "x-introduced": "1.0"
    },
    "successor": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ],
      "description": "the name of the rulebook that replaces this one, which an archived rulebook names (S28, S38); absent or null when it names none. The release's rule map toward it, where one is published, is the bundle's rule_map, whose rulebook is this name",
      "x-introduced": "1.3",
      "default": null
    }
  }
}
