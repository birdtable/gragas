{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-proposal.schema.json",
  "title": "A proposal as a document (spec 16.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "proposal"
  ],
  "properties": {
    "contract": {
      "$ref": "common.schema.json#/$defs/contract",
      "x-introduced": "1.0",
      "x-decides": "which contract version's schema reads the document, and whether it is read or ends not ready on a newer major"
    },
    "proposal": {
      "$ref": "entity-proposal.schema.json",
      "x-introduced": "1.0"
    }
  }
}
