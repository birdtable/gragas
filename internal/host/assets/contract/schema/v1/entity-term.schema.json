{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity-term.schema.json",
  "title": "Term (entity, spec 16.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "definition"
  ],
  "properties": {
    "slug": {
      "$ref": "common.schema.json#/$defs/slug",
      "x-introduced": "1.0"
    },
    "definition": {
      "$ref": "common.schema.json#/$defs/text",
      "x-introduced": "1.0"
    },
    "literal": {
      "$ref": "common.schema.json#/$defs/textOrEmpty",
      "x-introduced": "1.0",
      "default": ""
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "entity-translation.schema.json"
      },
      "x-introduced": "1.0",
      "default": []
    }
  }
}
