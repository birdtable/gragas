        ],
        "versions": ">=1.0.0",
        "cache_vars": [
          "LINT_B_CACHE",
          "LINT_B_MOD_CACHE"
        ]
      }
    ],
    "wasm": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  }
