    "name": "lint-b",
    "version": "0.10.0",
    "tool": "lint-b",
    "tool_versions": ">=1.0.0",
    "targets": [
      "config",
      "prose"
    ],
    "provides": [
      "entries"
    ],
    "extends": false,
    "warning": false,
    "programs": [
      {
        "id": "lint-b",
        "path": "bin/lint-b",
