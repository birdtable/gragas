{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate/exemptions.yaml: one format for every exception (gates.exemptions.2, gates.exemptions.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["exemptions"],
  "properties": {
    "exemptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "path", "reason", "exit", "owner", "expires"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "rule": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9-]+\\.[1-9][0-9]*$"},
          "path": {"type": "string", "minLength": 1, "description": "where the exception holds: a file, a folder or . for the program"},
          "reason": {"type": "string", "minLength": 20},
          "exit": {"type": "string", "minLength": 3, "description": "the artifact whose landing retires it: owner/repo#N, or a file of this repository"},
          "owner": {"type": "string", "minLength": 2},
          "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    }
  }
}
