{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate/subsets.json: the subset builds and what each must never link (arch.layers.13)",
  "type": "object",
  "additionalProperties": false,
  "required": ["subsets"],
  "properties": {
    "$comment": {"type": "string"},
    "subsets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "build", "decision", "why", "forbidden"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "build": {"enum": ["go", "ts"]},
          "entry": {"type": "string", "pattern": "^\\./cmd/[a-z][a-z0-9-]*$", "description": "go: the main package the subset builds"},
          "package": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "ts: the folder under explorer/packages"},
          "decision": {"$ref": "#/$defs/decision"},
          "why": {"type": "string", "minLength": 20},
          "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "no_embeds": {"type": "boolean", "description": "go: no package of the module may embed a file, past those allowed"},
          "markers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}, "description": "ts: text the build's output must never hold, such as the module path of a view it must not carry"},
          "allowed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "decision", "why"],
              "properties": {
                "package": {"type": "string", "minLength": 2},
                "decision": {"$ref": "#/$defs/decision"},
                "why": {"type": "string", "minLength": 20},
                "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "description": "go: the files the package embeds, exactly; a second embedded file is red"}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"build": {"const": "go"}}}, "then": {"required": ["entry", "no_embeds"], "not": {"anyOf": [{"required": ["package"]}, {"required": ["markers"]}]}}},
          {"if": {"properties": {"build": {"const": "ts"}}}, "then": {"required": ["package"], "not": {"anyOf": [{"required": ["entry"]}, {"required": ["no_embeds"]}, {"required": ["allowed"]}]}}}
        ]
      }
    }
  },
  "$defs": {
    "decision": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$", "description": "a record, the file docs/reasons/<decision>.md by that exact name"}
  }
}
